# Token de acesso permanente gerado no painel da Meta for Developers
WHATSAPP_TOKEN=seu_token_aqui

# ID do número de telefone do WhatsApp Business
# Encontrado em: Meta for Developers > App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# Token para verificação do webhook (você escolhe qualquer string)
WEBHOOK_VERIFY_TOKEN=metas_semanais_token

# Porta do servidor (padrão: 3000)
PORT=3000
