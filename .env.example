# Token de acesso permanente gerado no painel da Meta for Developers
WHATSAPP_TOKEN=seu_token_aqui

# ID do número de telefone do WhatsApp Business
# Encontrado em: Meta for Developers > App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# Token para verificação do webhook (você escolhe qualquer string)
WEBHOOK_VERIFY_TOKEN=metas_semanais_token

# App Secret do app na Meta (Configurações > Básico > "Chave secreta do app").
# Usado para validar a assinatura X-Hub-Signature-256 e garantir que as
# requisições vêm mesmo da Meta. Sem ele, o webhook aceita qualquer chamada.
WHATSAPP_APP_SECRET=seu_app_secret_aqui

# URL pública da aplicação (ex: https://meuapp.onrender.com)
# Necessário apenas no Render.com para o keep-alive automático
APP_URL=https://sua-url.onrender.com

# Persistência dos dados em um GitHub Gist (sobrevive a deploys/reinícios)
# Token clássico com escopo "gist": https://github.com/settings/tokens
GITHUB_TOKEN=ghp_seu_token_aqui
# ID do gist (a parte final da URL do gist criado em https://gist.github.com)
GIST_ID=seu_gist_id_aqui

# Números autorizados a usar o bot (separados por vírgula, só dígitos).
# Outros números são ignorados. Deixe vazio para liberar qualquer um.
# Ex: NUMEROS_AUTORIZADOS=5531993444893,5511988887777
NUMEROS_AUTORIZADOS=5531993444893

# Porta do servidor (padrão: 3000)
PORT=3000
